; gfx3d.v.pica (rewritten: native) - vertex stage of the 3D renderer (engine/gfx3d.c).
; Reproduces what the original vertex microcode did per vertex:
;   - transform by the matrix the vertex was loaded under (per-vertex palette index: limb matrices of
;     flexible skeletons, the caller's model matrix, segment matrices), then view x projection;
;   - directional lighting (ambient + up to 7 lights) with the normal transformed by the model matrix;
;   - environment-map texture coordinate generation from the normal and the camera axes;
;   - the two tile texture transforms (scale, shift, tile offset, size) for TEXEL0 and TEXEL1.
; Palette entry i occupies pal[7*i .. 7*i+6]: rows 0-3 model-view-projection, rows 4-6 normal matrix.

.fvec pal[56]
.fvec lightDir[7]
.fvec lightCol[7]
.fvec ambient
.fvec texA        ; s0, t0, s1, t1 scale
.fvec texB        ; s0, t0, s1, t1 offset
.fvec lookX
.fvec lookY
.bool lit
.bool texgen

.constf k(7.0, 1.0, 0.0, 0.5)
.constf k2(0.0078740157, 0.0039215686, 16384.0, 0.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias inpos v0
.alias inmtx v1
.alias inst v2
.alias inclr v3
.alias inalpha v4

.proc main
	mov r0.xyz, inpos
	mov r0.w, k.y
	mul r1.x, k.x, inmtx.x
	mova a0.x, r1.x
	dp4 outpos.x, pal[a0.x], r0
	dp4 outpos.y, pal[a0.x+1], r0
	dp4 outpos.z, pal[a0.x+2], r0
	dp4 outpos.w, pal[a0.x+3], r0

	ifu lit
		; normal: signed bytes / 127, to world space, normalised
		mul r2.xyz, k2.x, inclr.xyz
		mov r2.w, k.z
		dp3 r3.x, pal[a0.x+4], r2
		dp3 r3.y, pal[a0.x+5], r2
		dp3 r3.z, pal[a0.x+6], r2
		mov r3.w, k.z
		dp3 r4.x, r3, r3
		rsq r4.x, r4.x
		mul r3.xyz, r4.xxx, r3.xyz

		mov r5, ambient
		dp3 r6.x, lightDir[0], r3
		max r6.x, k.z, r6.x
		mad r5.xyz, r6.xxx, lightCol[0].xyz, r5.xyz
		dp3 r6.x, lightDir[1], r3
		max r6.x, k.z, r6.x
		mad r5.xyz, r6.xxx, lightCol[1].xyz, r5.xyz
		dp3 r6.x, lightDir[2], r3
		max r6.x, k.z, r6.x
		mad r5.xyz, r6.xxx, lightCol[2].xyz, r5.xyz
		dp3 r6.x, lightDir[3], r3
		max r6.x, k.z, r6.x
		mad r5.xyz, r6.xxx, lightCol[3].xyz, r5.xyz
		dp3 r6.x, lightDir[4], r3
		max r6.x, k.z, r6.x
		mad r5.xyz, r6.xxx, lightCol[4].xyz, r5.xyz
		dp3 r6.x, lightDir[5], r3
		max r6.x, k.z, r6.x
		mad r5.xyz, r6.xxx, lightCol[5].xyz, r5.xyz
		dp3 r6.x, lightDir[6], r3
		max r6.x, k.z, r6.x
		mad r5.xyz, r6.xxx, lightCol[6].xyz, r5.xyz
		min r5.xyz, k.yyy, r5.xyz
		mul r5.w, k2.y, inalpha.x
		mov outclr, r5

		ifu texgen
			dp3 r7.x, lookX, r3
			dp3 r7.y, lookY, r3
			add r7.xy, k.yy, r7.xy
			mul r7.xy, k2.zz, r7.xy
		.else
			mov r7.xy, inst.xy
		.end
	.else
		mul outclr, k2.yyyy, inclr
		mov r7.xy, inst.xy
	.end

	mov r8, r7.xyxy
	mul r8, texA, r8
	add r8, texB, r8
	mov outtc0, r8.xy
	mov outtc1, r8.zw
	end
.end
